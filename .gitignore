# Pixi environments — installed per-machine/arch; recreate with `pixi install`.
# (Commit pixi.lock, NOT this — the lock pins versions, the envs are ~GBs of binaries.)
.pixi/

# Workflow outputs — regenerated by `snakemake` (parquet/fastq/HTML, can be many GB).
/results/

# Snakemake working metadata / caches.
.snakemake/

# Python
__pycache__/
*.py[cod]

# OS / editor cruft
.DS_Store
*~

# Claude Code working dir: scratch output, plan files, local settings. None of it is repo history —
# what a plan decided ends up in the code and the commit message. Plans are still kept here (never
# overwritten: each planning round gets its own dated+versioned file) so they can be re-read locally.
.claude/
