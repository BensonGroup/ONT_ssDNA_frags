# ONT ligated-DNA selection-screen workflow.
#
#   raw fastqs -> nanocomp                 (cross-sample read QC; parallel branch, gates nothing)
#   clean -> train_hmm -> pychopper -> decode -> dedup -> featurecount -> {report_sample, report_cross}
#                                                    └─► umi_correct ─┬─► umi_matrix
#                                                                     └─► umi_complexity ─► report_umi_cross
#
# `umi.mode` (default `correct`) drives the UMI stage. The `dedup/` tree always QC-filters and feeds
# featurecount/reports (it COLLAPSES to molecules only in mode `dedup`). Mode `correct` additionally
# runs the independent `umi/` branch: ed<=1 UMI correction, a per-group corrected-UMI x sample
# matrix, and a cross-sample UMI report — none of which change the fragment counts.
#
# Run from the repo root (where pixi.toml lives):
#   snakemake -n                 # dry-run: inspect the DAG
#   snakemake --cores 18         # full run
# See README.md for prerequisites (pixi envs + the one-time fix-preprocess-env patch).
configfile: "config/config.yaml"


include: "rules/common.smk"


# `all` is defined before the rule modules so it is the default target.
rule all:
    input:
        # cross-sample read QC on the raw fastqs (NanoComp — one combined report)
        f"{OUTDIR}/qc/nanocomp/bysample_NanoComp-report.html",
        # one interactive report per sample (experimental + the initial library), built from the
        # processed dedup/ tree when the UMI stage runs (filter and/or collapse), else raw decode
        [f"{report_stem(s)}.featurecount_report.html" for s in SAMPLES],
        # the cross-sample comparison report, over that same tree
        f"{OUTDIR}/{CROSSBASE}/cross_sample_featurecount_report.html",
        # summaries (parity with the legacy scripts)
        f"{OUTDIR}/clean/clean_summary.tsv",
        f"{OUTDIR}/preprocess/batch_summary.tsv",
        *([f"{OUTDIR}/dedup/umi_dedup_summary.tsv"] if UMI_STAGE_ON else []),
        # UMI characterisation branch (mode `correct`): per-group corrected-UMI x sample matrices,
        # the depth-robust effective-complexity tables, and the cross-sample UMI report. Independent
        # of the fragment reports above. The two complexity TSVs are listed even though the report
        # pulls them in transitively — they are outputs in their own right and survive if the report
        # is ever switched off.
        *([f"{OUTDIR}/umi/{g}.umi_x_sample.mtx" for g in GROUPS] if UMI_CORRECT_ON else []),
        *([f"{OUTDIR}/umi/umi_complexity.tsv",
           f"{OUTDIR}/umi/umi_collapse.tsv"] if UMI_CORRECT_ON else []),
        *([f"{OUTDIR}/umi/umi_report_cross.html"] if UMI_CORRECT_ON else []),


include: "rules/qc.smk"
include: "rules/setup.smk"
include: "rules/refs.smk"
include: "rules/clean.smk"
include: "rules/hmm.smk"
include: "rules/preprocess.smk"
include: "rules/decode.smk"
include: "rules/dedup.smk"
include: "rules/umi.smk"
include: "rules/featurecounts.smk"
include: "rules/reports.smk"
