# ONT ligated-DNA selection-screen workflow.
#
#   raw fastqs -> nanocomp        (cross-sample read QC; parallel branch, gates nothing)
#   clean -> train_hmm -> pychopper -> decode ─► featurecount ─► fragment report   [RAW]
#                                        └─► coverage ─► covfilt ─► umi_correct ─► umicorr
#                                              └─► jackpot detect (R0) ─► blacklist + jackpot reports
#                                                    └─► jackpot apply ─► umi ─┬─► featurecount ─► fragment report [CLEAN]
#                                                                              ├─► umi_matrix, umi_complexity ─► umi report
#                                                                              └─► fragvec ─► fragvec report
#
# ONE spine, and every readout hangs off its clean end, so nothing disagrees about which reads exist.
# Two read-level cuts, each measured where its signal is identifiable:
#   `decode_filter.min_coverage` drops reads the decoder barely explained (a decode-step property).
#   `jackpot` drops the artefact barcodes the NAIVE R0 library exposes (identifiable only there).
# Nothing is ever COLLAPSED -- the typical molecule is seen about once and high-count lineages are
# the signal, not noise (clarification.md:667).
#
# TWO fragment reports, one either side of the UMI processing: the same rule serves both trees, and
# their difference IS the funnel (coverage-dropped, garbage-UMI, anchor-only, jackpot).
#
# Run from the repo root (where pixi.toml lives):
#   snakemake -n                 # dry-run: inspect the DAG
#   snakemake --cores 18         # full run
# See README.md for prerequisites (pixi envs + the one-time fix-preprocess-env patch).
configfile: "config/config.yaml"


include: "rules/common.smk"


# `all` is defined before the rule modules so it is the default target.
rule all:
    input:
        # cross-sample read QC on the raw fastqs (NanoComp — one combined report)
        f"{OUTDIR}/qc/nanocomp/bysample_NanoComp-report.html",
        # one interactive report per sample (experimental + the initial library), on the clean tree
        [f"{report_stem(s)}.featurecount_report.html" for s in SAMPLES],
        # TWO cross-sample fragment reports, bracketing the UMI processing: the RAW decode tree and
        # the CLEAN one. Same rule, different {crossbase}. Their difference is the read funnel.
        f"{OUTDIR}/decode/cross_sample_featurecount_report.html",
        f"{OUTDIR}/{CROSSBASE}/cross_sample_featurecount_report.html",
        # summaries (parity with the legacy scripts)
        f"{OUTDIR}/clean/clean_summary.tsv",
        f"{OUTDIR}/preprocess/batch_summary.tsv",
        # decode coverage filter: how many reads each sample lost below decode_filter.min_coverage.
        # The covfilt/ tree itself is pulled in transitively by every branch below; this is the
        # cross-sample QC row, an output in its own right.
        *([f"{OUTDIR}/covfilt/coverage_summary.tsv"] if DECODE_FILTER_ON else []),
        # the jackpot audit: which fragvecs were flagged, why, and what the blacklist removed.
        # A first-class output of the umi step, not a re-render of the reports below.
        *([f"{OUTDIR}/jackpot/{INITIAL}.umi_jackpot_report.html",
           f"{OUTDIR}/jackpot/{INITIAL}.fragvec_jackpot_report.html"] if JACKPOT_ON else []),
        # UMI characterisation: per-group corrected-UMI x sample matrices, the depth-robust
        # effective-complexity tables, and the cross-sample UMI report — all over the CLEAN tree.
        # The two complexity TSVs are listed even though the report pulls them in transitively —
        # they are outputs in their own right and survive if the report is ever switched off.
        [f"{OUTDIR}/umi/{g}.umi_x_sample.mtx" for g in GROUPS],
        f"{OUTDIR}/umi/umi_complexity.tsv",
        f"{OUTDIR}/umi/umi_collapse.tsv",
        f"{OUTDIR}/umi/umi_report_cross.html",
        # fragment-vector branch (the two-axis readout): per-group vector x sample matrices + report.
        # A sibling of the umi/ branch — independently switchable; run either or both.
        *([f"{OUTDIR}/fragvec/{g}.fragvec_x_sample.reads.mtx" for g in GROUPS] if FRAGVEC_ON else []),
        *([f"{OUTDIR}/fragvec/fragvec_report_cross.html"] if FRAGVEC_ON else []),
        # Optional outputs are selected by the static-plot rule module.
        lambda wc: static_plot_targets(),


include: "rules/qc.smk"
include: "rules/setup.smk"
include: "rules/refs.smk"
include: "rules/clean.smk"
include: "rules/hmm.smk"
include: "rules/preprocess.smk"
include: "rules/decode.smk"
include: "rules/coverage.smk"
include: "rules/umi.smk"
include: "rules/jackpot.smk"
include: "rules/fragvec.smk"
include: "rules/featurecounts.smk"
include: "rules/reports.smk"
include: "rules/static_plots.smk"
